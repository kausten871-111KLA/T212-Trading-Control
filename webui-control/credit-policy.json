{
  "version": "0.1",
  "mode": "OBSERVE_AND_REPORT",
  "currency_spend_authorised": false,
  "monthly_capacity_plan": {
    "unit": "CREDITS",
    "minimum": 2000000000,
    "maximum": 4000000000,
    "enforcement": "REPORT_ONLY"
  },
  "workspaces": [
    "t212-demo",
    "apps-plugins-bots",
    "you-heal-content",
    "books-publishing"
  ],
  "event_fields": [
    "event_id",
    "run_id",
    "workspace",
    "timestamp",
    "provider",
    "model_role",
    "model_id_ref",
    "input_fingerprint",
    "cache_hit",
    "units",
    "currency_cost"
  ],
  "privacy": {
    "store_prompt_content": false,
    "store_response_content": false,
    "store_credentials": false,
    "model_id_reference_only": true
  },
  "units": {
    "required": [
      "input",
      "output",
      "cache_read",
      "total"
    ],
    "total_rule": "input + output + cache_read"
  },
  "controls": {
    "require_metering_for_completed_model_run": true,
    "flag_uncached_duplicate_fingerprints": true,
    "aggregate_by_workspace": true,
    "aggregate_by_model_role": true,
    "currency_conversion_enabled": false,
    "automatic_provider_upgrade": false,
    "automatic_spend_increase": false
  },
  "alerts": {
    "per_event_credit_limit": null,
    "monthly_currency_limit": null,
    "missing_metering": true,
    "duplicate_uncached_work": true
  },
  "human_approval_required_for": [
    "currency_budget_change",
    "provider_plan_change",
    "monthly_capacity_change",
    "hard_limit_enablement"
  ]
}
