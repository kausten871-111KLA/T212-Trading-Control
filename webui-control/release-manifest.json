{
  "version": "0.1",
  "release_name": "webui-control-plane-foundation",
  "release_state": "STAGED_NOT_DEPLOYED",
  "live_effect": false,
  "source_branch": "feature/t212-instrument-cache-v03",
  "components": [
    {
      "id": "workspace-registry",
      "config": "webui-control/workspaces.json",
      "code": null
    },
    {
      "id": "agent-contract",
      "config": "webui-control/agent-contract.json",
      "code": null
    },
    {
      "id": "model-router",
      "config": "webui-control/model-router.json",
      "code": "openwebui/tools/model_router.py"
    },
    {
      "id": "plugin-registry",
      "config": "webui-control/plugin-registry.json",
      "code": "openwebui/tools/plugin_registry.py"
    },
    {
      "id": "automation-ledger",
      "config": "webui-control/automation-run-schema.json",
      "code": "openwebui/tools/automation_ledger.py"
    },
    {
      "id": "shift-handoff",
      "config": "webui-control/shift-handoff-schema.json",
      "code": "openwebui/tools/shift_handoff.py"
    }
  ],
  "gates": {
    "tests_command": "python -m unittest discover -s tests",
    "preflight_command": "python scripts/verify_webui_control.py",
    "require_clean_test_exit": true,
    "require_exact_commit_checkout": true,
    "require_backup_evidence_before_deploy": true,
    "require_human_approval_before_deploy": true,
    "forbid_secrets_in_repository": true
  },
  "trading_safety": {
    "environment": "DEMO",
    "live_trading": false,
    "order_mutation_during_control_plane_validation": false,
    "fail_closed": true
  },
  "rollback": {
    "database_backup_required": true,
    "tool_table_backup_required": true,
    "method": "Disable new integration points and restore the recorded pre-deployment Open WebUI configuration/database backup.",
    "preserve_audit_evidence": true
  }
}
