  "gates": {
    "tests_command": "python -m unittest discover -s tests",
    "preflight_command": "python scripts/verify_webui_control.py",
    "workspace_contract_command": "python scripts/validate_workspace_runtime_contract.py",
    "runtime_evidence_command": "python scripts/collect_runtime_evidence.py --output /var/lib/t212-scanner/runtime_evidence.json",
    "implementation_register_command": "python scripts/build_implementation_register.py --evidence /var/lib/t212-scanner/runtime_evidence.json",
    "t212_gap_register_command": "python scripts/build_t212_gap_register.py --runtime-evidence /var/lib/t212-scanner/runtime_evidence.json",
    "require_clean_test_exit": true,
    "require_exact_commit_checkout": true,
    "require_backup_evidence_before_deploy": true,
    "require_human_approval_before_deploy": true,
    "forbid_secrets_in_repository": true,
    "require_runtime_evidence_for_proven_status": true,
    "workspace_isolation_command": "python scripts/audit_workspace_isolation.py",
    "demo_validation_status_command": "python scripts/build_demo_validation_status.py --ledger /var/lib/t212-scanner/demo_validation.jsonl"
  },
  "trading_safety": {
    "environment": "DEMO",
    "live_trading": false,
    "order_mutation_during_control_plane_validation": false,
    "fail_closed": true
  },
  "rollback": {
    "database_backup_required": true,
    "tool_table_backup_required": true,
    "method": "Disable new integration points and restore the recorded pre-deployment Open WebUI configuration/database backup.",
    "preserve_audit_evidence": true
  }
}
