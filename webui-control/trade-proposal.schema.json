{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-proposal.schema.json",
  "title": "T212 DEMO Trade Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "symbol",
    "ordinary_ticker",
    "t212_ticker",
    "generated_at",
    "data_source",
    "data_age_seconds",
    "candidate_source",
    "reason",
    "catalyst_evidence",
    "cause_confidence",
    "qualification_gates",
    "entry_range",
    "profit_targets",
    "risk_stop",
    "holding_period",
    "liquidity",
    "spread",
    "volatility",
    "dilution_or_manipulation_risk",
    "confidence_evidence_level",
    "intended_exposure",
    "quantity",
    "broker_tradability",
    "approval_state",
    "execution_state",
    "safety"
  ],
  "properties": {
    "proposal_id": {"type":"string","minLength":1},
    "symbol": {"type":"string","minLength":1},
    "ordinary_ticker": {"type":"string","minLength":1},
    "t212_ticker": {"type":"string","minLength":1},
    "generated_at": {"type":"string","format":"date-time"},
    "data_source": {"type":"string","minLength":1},
    "data_age_seconds": {"type":"number","minimum":0},
    "candidate_source": {"type":"string","minLength":1},
    "reason": {"type":"string","minLength":1},
    "catalyst_evidence": {"type":"array","items":{"type":"object"},"minItems":1},
    "cause_confidence": {"enum":["CONFIRMED","PROBABLE","UNKNOWN"]},
    "qualification_gates": {"type":"object"},
    "entry_range": {
      "type":"object",
      "required":["low","high"],
      "properties":{"low":{"type":"number","exclusiveMinimum":0},"high":{"type":"number","exclusiveMinimum":0}},
      "additionalProperties":false
    },
    "profit_targets": {"type":"array","items":{"type":"number","exclusiveMinimum":0},"minItems":1},
    "risk_stop": {"type":"number","exclusiveMinimum":0},
    "holding_period": {"type":"string","minLength":1},
    "liquidity": {"type":"object"},
    "spread": {"type":"object"},
    "volatility": {"type":"object"},
    "dilution_or_manipulation_risk": {"type":"object"},
    "confidence_evidence_level": {"type":"string","minLength":1},
    "intended_exposure": {"type":"number","exclusiveMinimum":0},
    "quantity": {"type":"number","exclusiveMinimum":0},
    "broker_tradability": {"const":true},
    "approval_state": {"enum":["PENDING","APPROVED","REJECTED"]},
    "execution_state": {"enum":["NOT_SUBMITTED","SUBMITTED","ACKNOWLEDGED","FILLED","CLOSED","REJECTED","BLOCKED"]},
    "safety": {
      "type":"object",
      "additionalProperties":false,
      "required":["environment","live_trading","order_mutation_authorized"],
      "properties":{
        "environment":{"const":"DEMO"},
        "live_trading":{"const":false},
        "order_mutation_authorized":{"type":"boolean"}
      }
    }
  }
}
