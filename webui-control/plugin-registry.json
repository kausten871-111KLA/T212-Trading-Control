{
  "version": "0.1",
  "default_policy": {
    "fail_closed": true,
    "allow_unregistered_connectors": false,
    "allow_unverified_install": false,
    "store_secret_values_in_registry": false,
    "require_health_check_before_use": true,
    "require_human_approval_for": [
      "publish",
      "deploy",
      "merge",
      "external_write",
      "spend",
      "order_mutation"
    ]
  },
  "workspaces": [
    "t212-demo",
    "apps-plugins-bots",
    "you-heal-content",
    "books-publishing"
  ],
  "connectors": [
    {
      "id": "github",
      "purpose": "Versioned source control for WebUI configuration, tools, tests and rollback material.",
      "owner_workspace": "apps-plugins-bots",
      "available_to": [
        "apps-plugins-bots",
        "t212-demo",
        "you-heal-content",
        "books-publishing"
      ],
      "source": {
        "type": "official_app",
        "verified": true
      },
      "state": "connected",
      "permissions": [
        "repository_metadata:read",
        "contents:read",
        "feature_branch:write",
        "pull_requests:read"
      ],
      "denied_operations": [
        "force_push",
        "delete_repository",
        "write_default_branch",
        "merge_without_approval"
      ],
      "secret_env": [],
      "health_check": {
        "type": "read_only",
        "operation": "repository_and_branch_metadata"
      },
      "approval_level": "human_for_protected_write",
      "fallback": "record_handoff_and_continue_local_branch_work"
    },
    {
      "id": "model-provider-router",
      "purpose": "Resolve approved text, reasoning, vision and high-capability logical model roles.",
      "owner_workspace": "apps-plugins-bots",
      "available_to": [
        "apps-plugins-bots",
        "t212-demo",
        "you-heal-content",
        "books-publishing"
      ],
      "source": {
        "type": "internal_control_plane",
        "verified": true
      },
      "state": "staged",
      "permissions": [
        "model_inference"
      ],
      "denied_operations": [
        "secret_passthrough",
        "vision_to_text_only_downgrade"
      ],
      "secret_env": [
        "MODEL_PROVIDER_API_KEY"
      ],
      "model_binding_env": [
        "WEBUI_MODEL_FAST_TEXT",
        "WEBUI_MODEL_DEEP_REASONING",
        "WEBUI_MODEL_VISION",
        "WEBUI_MODEL_HIGH_CAPABILITY"
      ],
      "health_check": {
        "type": "read_only",
        "operation": "capability_probe_and_binding_check"
      },
      "approval_level": "human_for_provider_or_model_change",
      "fallback": "block_missing_capability_and_report"
    },
    {
      "id": "openwebui-file-store",
      "purpose": "Workspace-scoped document and attachment visibility inside Open WebUI.",
      "owner_workspace": "apps-plugins-bots",
      "available_to": [
        "apps-plugins-bots",
        "you-heal-content",
        "books-publishing"
      ],
      "source": {
        "type": "openwebui_builtin",
        "verified": true
      },
      "state": "staged",
      "permissions": [
        "workspace_files:read",
        "workspace_files:create_version"
      ],
      "denied_operations": [
        "delete_source_file",
        "overwrite_source_file",
        "cross_workspace_retrieval",
        "public_share"
      ],
      "secret_env": [],
      "health_check": {
        "type": "read_only",
        "operation": "workspace_scope_and_attachment_read"
      },
      "approval_level": "human_for_external_share_or_delete",
      "fallback": "preserve_source_and_record_visibility_blocker"
    },
    {
      "id": "t212-demo-readiness",
      "purpose": "DEMO-only cached instruments, quotes, account state and reconciliation evidence.",
      "owner_workspace": "t212-demo",
      "available_to": [
        "t212-demo"
      ],
      "source": {
        "type": "internal_gateway",
        "verified": true
      },
      "state": "staged",
      "permissions": [
        "demo_account:read",
        "demo_instruments:read",
        "demo_quotes:read",
        "demo_positions:read",
        "demo_history:read"
      ],
      "denied_operations": [
        "live_endpoint",
        "live_credentials",
        "order_create",
        "order_modify",
        "order_cancel",
        "automatic_retry_of_order_post"
      ],
      "secret_env": [
        "T212_DEMO_API_KEY",
        "T212_DEMO_API_SECRET"
      ],
      "endpoint_policy": {
        "environment": "DEMO",
        "live_trading": false,
        "order_mutation": false,
        "fail_closed": true
      },
      "health_check": {
        "type": "read_only",
        "operation": "demo_auth_instrument_cache_and_freshness"
      },
      "approval_level": "separate_exact_human_approval_required_for_any_future_demo_order_bridge",
      "fallback": "halt_and_report"
    }
  ]
}
