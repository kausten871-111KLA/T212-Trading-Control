[Unit]
Description=T212 missed-green EOD audit (read-only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
User=katie
WorkingDirectory=/home/katie/t212-scanner
ExecStart=/usr/bin/python3 /home/katie/t212-scanner/worker/run_eod_audit.py
Environment=T212_SCANNER_STATE_DIR=/var/lib/t212-scanner
TimeoutStartSec=3min
Restart=on-failure
RestartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/t212-scanner
