[Unit]
Description=T212 deterministic discovery cycle (read-only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
User=katie
WorkingDirectory=/home/katie/t212-scanner
Environment=PYTHONUNBUFFERED=1
Environment=T212_SCANNER_STATE_DIR=/var/lib/t212-scanner
EnvironmentFile=-/etc/t212-scanner/runtime.env
ExecStartPre=/usr/bin/python3 /home/katie/t212-scanner/worker/produce_market_snapshot.py
ExecStart=/usr/bin/python3 /home/katie/t212-scanner/worker/run_discovery_cycle.py
TimeoutStartSec=4min
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/t212-scanner
