[Unit]
Description=Run T212 deterministic discovery during approved UK-time session

[Timer]
OnCalendar=Mon..Fri *-*-* 14:20/5:00 Europe/London
OnCalendar=Mon..Fri *-*-* 15..20:00/5:00 Europe/London
OnCalendar=Mon..Fri *-*-* 21:00..05/5:00 Europe/London
Persistent=true
AccuracySec=20s
Unit=t212-discovery.service

[Install]
WantedBy=timers.target
