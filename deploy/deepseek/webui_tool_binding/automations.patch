+        log.warning('Automation model registry missing configured tool IDs for %s; resolving from persisted model', model_id)
+        meta = {**meta, 'toolIds': sorted(persisted_tool_ids)}
+    elif persisted_tool_ids - cached_tool_ids:
+        raise RuntimeError(
+            'Automation model tool metadata differs from saved configuration; '
